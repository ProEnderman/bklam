# ===========================================
# BKLAM — общие переменные окружения проекта
# ===========================================
# Скопируйте в .env и заполните значения.
# Для локального запуска: export перед ./start-all.sh или source .env в скрипте.
# Для Docker: docker-compose подхватывает .env из этой папки.
#
# Convention (portfolio): one comment line per variable; placeholder values are not production secrets.

# --- Java Backend (application.yml) ---
APP_ENV=dev
ALLOW_INSECURE_DEV_SECRETS=false

# Подмена времени: на prod/stage-профилях всегда выключена.
# Если задано true/false — переопределяет эвристику по spring.profiles.active.
# APP_TIME_OVERRIDE_ENABLED=true

# HTTP port for the Spring Boot API (dev default; override if 8080 is taken).
PORT=8080

# --- Dev (стандарт): профили dev / local-docker — см. application-dev.yml, application-local-docker.yml
# Единый JDBC для локальной разработки; имя БД в пути: restaurant_db_dev
DEV_DB_URL=jdbc:postgresql://localhost:5432/restaurant_db_dev
# После изменения уже применённых Flyway-файлов: пересоздайте эту БД или `flyway repair` для этого URL (иначе приложение не стартует).

# Postgres из Docker Compose на хосте (порт 5433):
# DEV_DB_URL=jdbc:postgresql://localhost:5433/restaurant_db_dev

# Docker Compose: имя БД в контейнере (должно совпадать с именем в DEV_DB_URL)
POSTGRES_DB=restaurant_db_dev

# --- Legacy / без профиля dev (как в application.yml по умолчанию)
# Не используйте как основной способ dev — только если нужен старый сценарий с БД restaurant_db.
# DB_URL=jdbc:postgresql://localhost:5432/restaurant_db

DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- DB roles & RLS ---
# Tenant JDBC (JPA): use a NON-superuser role in production (e.g. app_tenant) so RLS policies apply.
# Do NOT use superuser or any role with BYPASSRLS for APP_TENANT_DB_USERNAME.
# Platform JDBC (cross-tenant jobs): optional separate role (e.g. app_platform from V66); defaults to DB_USERNAME if unset.
# APP_TENANT_DB_USERNAME=app_tenant
# APP_TENANT_DB_PASSWORD=...
# APP_PLATFORM_DB_USERNAME=app_platform
# APP_PLATFORM_DB_PASSWORD=...

# Redis (optional): docker-compose `redis` + telegram-payment-service only — backend uses in-memory rate limits.
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=

# Required for secret validation at startup. For `./gradlew devBootRun` or `SPRING_PROFILES_ACTIVE=dev ./gradlew bootRun`,
# Gradle merges this file into the process env when keys are unset (see build.gradle).
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
TRUST_PROXY=true

# Optional: second HEAD_ADMIN from local secrets (not in git). Bean runs only if profile is not "prod".
# SEED_PERSONAL_HEAD_ADMIN_ENABLED=true
# SEED_PERSONAL_HEAD_ADMIN_EMAIL=
# SEED_PERSONAL_HEAD_ADMIN_PASSWORD=

# QR-меню
QR_SIGNING_SECRET=REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS
QR_MENU_BASE_URL=http://localhost:3000

# Прогнозы (Java → Python)
FORECAST_SERVICE_URL=http://localhost:8090
FORECAST_INTERNAL_JWT_SECRET_B64=REPLACE_WITH_BASE64_SECRET_32_PLUS_BYTES

# Telegram
# Webhook: если TELEGRAM_WEBHOOK_ENABLED=true — TELEGRAM_WEBHOOK_SECRET обязателен при старте (≥16 символов).
TELEGRAM_WEBHOOK_ENABLED=false
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBAPP_MAX_AUTH_AGE_SECONDS=86400
TELEGRAM_DEFAULT_RESTAURANT_ID=0
TELEGRAM_PAYMENT_SERVICE_URL=http://localhost:3001
# Actuator HTTP-пробы к forecast / telegram-payment (см. docs/PRODUCTION_RUNBOOK.md)
# FORECAST_HEALTH_CHECK=true
# FORECAST_HEALTH_OPTIONAL=true
# TELEGRAM_PAYMENT_HEALTH_CHECK=true
# TELEGRAM_PAYMENT_HEALTH_OPTIONAL=true

# Email (SMTP2GO)
SMTP2GO_API_KEY=
SMTP2GO_FROM_EMAIL=authorisation@bklam.ru

# Telegram payment (docker-compose)
TELEGRAM_PAYMENT_MASTER_KEY=REPLACE_WITH_BASE64_SECRET_32_PLUS_BYTES

# --- Docker: те же имена передаются в backend и forecast ---
# FORECAST_INTERNAL_JWT_SECRET_B64=... (обязателен; один и тот же для Java и Python)

# --- Подпроекты (свои .env) ---
# telegram-payment-service: см. telegram-payment-service/env.example → .env
# forecasting (Python): FORECAST_INTERNAL_JWT_SECRET_B64, FORECAST_INTERNAL_JWT_ISSUER, JAVA_BACKEND_URL
