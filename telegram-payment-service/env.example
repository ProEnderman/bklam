# ===========================================
# Telegram Payment Service - Environment Config
# ===========================================
# Copy this file to .env and fill in your values

# Runtime mode / secret policy
APP_ENV=dev
ALLOW_INSECURE_DEV_SECRETS=false

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/telegram_payments?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT (for API auth)
JWT_SECRET="REPLACE_WITH_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="1d"

# Telegram API (get from https://my.telegram.org)
TG_API_ID=123456
TG_API_HASH="your-api-hash"

# Telegram Bot Token (for Login Widget verification)
# Create bot via @BotFather
TG_BOT_TOKEN="123456789:ABC-DEF..."

# Bank Bot Configuration
BANK_BOT_USERNAME="BankPaymentBot"

# TODO: Adjust template based on actual bank bot format
BANK_BOT_MESSAGE_TEMPLATE="Оплата заказа №{invoiceId}\nСумма: {amount} {currency}\nМаркер: {paymentRequestId}"

# Allowed domains for payment URLs (comma-separated)
# Use * to accept ANY URL (for testing only!)
BANK_ALLOWED_DOMAINS="*"
# Для продакшена укажите реальные домены:
# BANK_ALLOWED_DOMAINS="pay.bank.ru,secure.bank.ru,payment.bank.ru"

# Encryption
# Generate: openssl rand -base64 32
MASTER_KEY="REPLACE_WITH_BASE64_SECRET_32_PLUS_BYTES"

# Key ID for encryption key rotation
ENCRYPTION_KEY_ID="v1"

# Timeouts (in milliseconds)
# 60 секунд - достаточно времени для ручного ответа
BANK_BOT_REPLY_TIMEOUT_MS=60000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# QR Code
QR_CACHE_TTL_SECONDS=900

# Logging
LOG_LEVEL="info"
